{
  "name": "@cso-voting/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "test": "vitest",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:import-students": "tsx scripts/import-students.ts",
    "db:seed-voter": "tsx scripts/seed-voter.ts",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/zod-openapi": "^0.19.10",
    "@libsql/client": "^0.15.15",
    "@scalar/hono-api-reference": "^0.9.30",
    "backblaze-b2": "^1.7.1",
    "bad-words": "^4.0.0",
    "dotenv": "^16.6.1",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.11.1",
    "hono-pino": "^0.8.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/backblaze-b2": "^1.5.6",
    "@types/node": "^20.19.27",
    "@types/pdf-parse": "^1.1.5",
    "drizzle-kit": "^0.31.8",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.106.0"
  }
}
