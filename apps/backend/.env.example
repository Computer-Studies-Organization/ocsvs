NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
OFFLINE_DEV=false

# Database
# ----
# Local SQLite file (recommended for development — no auth token needed):
#   TURSO_DATABASE_URL=file:./local.db
#
# In-memory database (ephemeral, resets on restart):
#   TURSO_DATABASE_URL=:memory:
#
# Remote Turso (production/staging):
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=your-auth-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Offline Worker development (use `pnpm dev:offline`):
#   OFFLINE_DEV=true
#   TURSO_DATABASE_URL=http://127.0.0.1:8080
#   TURSO_AUTH_TOKEN=offline-local-token

# Base64-encoded pepper for voter participation HMAC hashes (decodes to at least 32 bytes).
# Generate a new key using: openssl rand -base64 32
HMAC_SECRET=
# Optional comma-separated base64 keys retained when rotating HMAC_SECRET.
PREVIOUS_HMAC_SECRETS=
