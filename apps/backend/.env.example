NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# Database
# ----
# Local SQLite file (recommended for development — no auth token needed):
#   TURSO_DATABASE_URL=file:./local.db
#
# In-memory database (ephemeral, resets on restart):
#   TURSO_DATABASE_URL=:memory:
#
# Remote Turso (production/staging):
#   TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
#   TURSO_AUTH_TOKEN=your-auth-token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
