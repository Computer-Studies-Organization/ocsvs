# Hoist common test/lint runners to root node_modules/.bin so root-level
# `npm test`/`npm run lint`/`npm run typecheck` scripts resolve the binary
# without `cd`-ing into a workspace. Pnpm's default isolation would otherwise
# keep these binaries workspace-local only.
public-hoist-pattern[]=*vitest*
public-hoist-pattern[]=*svelte-check*
public-hoist-pattern[]=*oxlint*
public-hoist-pattern[]=*oxfmt*
public-hoist-pattern[]=*typescript*
