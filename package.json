{
  "name": "cso-voting",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for CSO Voting application",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @cso-voting/backend exec oxlint . && pnpm --filter @cso-voting/backend exec oxfmt --check . && pnpm --filter @cso-voting/frontend lint",
    "test": "pnpm --filter @cso-voting/backend exec vitest run && pnpm --filter @cso-voting/frontend test",
    "test:e2e": "pnpm --filter @cso-voting/e2e test",
    "clean": "pnpm -r clean",
    "dev:frontend": "pnpm --filter @cso-voting/frontend dev",
    "dev:backend": "pnpm --filter @cso-voting/backend dev",
    "build:frontend": "pnpm --filter @cso-voting/frontend build",
    "build:backend": "pnpm --filter @cso-voting/backend build"
  },
  "devDependencies": {
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "defu": "6.1.7",
      "ws": "8.21.0",
      "yaml": "2.9.0"
    }
  }
}
